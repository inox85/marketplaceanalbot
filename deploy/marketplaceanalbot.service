[Unit]
Description=Marketplace Facebook groups monitor bot
After=network-online.target
Wants=network-online.target
# Nessun limite al numero di riavvii: preferiamo che il bot continui a
# ritentare all'infinito piuttosto che fermarsi silenziosamente dopo
# troppi crash ravvicinati (comportamento di default di systemd).
StartLimitIntervalSec=0

[Service]
Type=simple
User=rpi
WorkingDirectory=/home/rpi/src/marketplaceanalbot
# Senza questa, l'output di Python è bufferizzato quando non gira su un
# terminale: i print() del bot arriverebbero a journalctl/bot.log solo a
# blocchi (o mai, se il processo viene ucciso prima del flush).
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rpi/src/marketplaceanalbot/venv/bin/python3 main.py --headless --workers 3
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
